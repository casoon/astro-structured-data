---
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { articleZodSchema, type ArticleProps } from '../zod';
import { parseProps } from '../utils/validate';
import { pageUrl } from '../utils/meta';
import { buildArticle } from '../builders/article';

type Props = ArticleProps;

const page = Astro.url.pathname;
const { changefreq, priority, ...props } = parseProps('ArticleSchema', articleZodSchema, Astro.props, page);

const globalConfig = getGlobalConfig();
const articleSchema = buildArticle(props, { url: pageUrl(page, globalConfig.siteUrl), page, config: globalConfig });
---
<Schema item={articleSchema} changefreq={changefreq} priority={priority} />
