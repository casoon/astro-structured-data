---
import type { BreadcrumbList } from 'schema-dts';
import Schema from './Schema.astro';
import { breadcrumbZodSchema, type BreadcrumbProps } from '../zod';
import { parseProps } from '../utils/validate';

type Props = BreadcrumbProps;

const { id, changefreq, priority, items } = parseProps('BreadcrumbSchema', breadcrumbZodSchema, Astro.props, Astro.url.pathname);

const breadcrumbSchema: BreadcrumbList = {
  '@type': 'BreadcrumbList',
  ...(id && { '@id': id }),
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
};
---
<Schema item={breadcrumbSchema} changefreq={changefreq} priority={priority} />
