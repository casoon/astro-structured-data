---
import type { SoftwareApplication } from 'schema-dts';
import Schema from './Schema.astro';
import { softwareAppZodSchema, type SoftwareAppProps } from '../zod';
import { parseProps } from '../utils/validate';

type Props = SoftwareAppProps;

const {
  changefreq,
  priority,
  name,
  description,
  url,
  operatingSystem, // e.g. "Windows, macOS, Linux" or "Web"
  applicationCategory, // e.g. "DeveloperApplication", "Game", "BusinessApplication"
  price,
  priceCurrency,
  ratingValue,
  reviewCount,
} = parseProps('SoftwareAppSchema', softwareAppZodSchema, Astro.props, Astro.url.pathname);

const appSchema: SoftwareApplication = {
  '@type': 'SoftwareApplication',
  name,
  ...(description && { description }),
  ...(url && { url }),
  ...(operatingSystem && { operatingSystem }),
  ...(applicationCategory && { applicationCategory }),
  ...(price !== undefined && {
    offers: {
      '@type': 'Offer',
      price,
      priceCurrency,
    }
  }),
  ...(ratingValue !== undefined && reviewCount !== undefined && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue,
      reviewCount,
    }
  })
} as SoftwareApplication;
---
<Schema item={appSchema} changefreq={changefreq} priority={priority} />
