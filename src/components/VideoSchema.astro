---
import Schema from './Schema.astro';
import { videoZodSchema, type VideoProps } from '../zod';
import { parseProps } from '../utils/validate';

type Props = VideoProps;

const {
  changefreq,
  priority,
  name,
  description,
  thumbnailUrl,
  uploadDate,
  duration,
  contentUrl,
  embedUrl,
  interactionCount,
  expires,
  publisher,
} = parseProps('VideoSchema', videoZodSchema, Astro.props, Astro.url.pathname);

const videoSchema: Record<string, any> = {
  '@type': 'VideoObject',
  name,
  description,
  thumbnailUrl: Array.isArray(thumbnailUrl) ? thumbnailUrl : [thumbnailUrl],
  uploadDate,
};

if (duration) videoSchema.duration = duration;
if (contentUrl) videoSchema.contentUrl = contentUrl;
if (embedUrl) videoSchema.embedUrl = embedUrl;

if (interactionCount !== undefined) {
  videoSchema.interactionStatistic = {
    '@type': 'InteractionCounter',
    interactionType: { '@type': 'WatchAction' },
    userInteractionCount: Number(interactionCount),
  };
}

if (expires) videoSchema.expires = expires;

if (publisher) {
  videoSchema.publisher = {
    '@type': 'Organization',
    name: publisher.name,
    ...(publisher.logoUrl && {
      logo: { '@type': 'ImageObject', url: publisher.logoUrl },
    }),
  };
}
---
<Schema item={videoSchema} changefreq={changefreq} priority={priority} />
