---
import type { ProfilePage } from 'schema-dts';
import Schema from './Schema.astro';
import { profilePageZodSchema, type ProfilePageProps } from '../zod';
import { parseProps } from '../utils/validate';
import { buildReference } from '../utils/reference';

type Props = ProfilePageProps;

const {
  changefreq,
  priority,
  name,
  id,
  mainEntityType = 'Person',
  url,
  alternateName,
  identifier,
  jobTitle,
  worksFor,
  knowsAbout,
  dateCreated,
  dateModified,
  description,
  imageUrl,
  sameAs,
  publishingPrinciples,
} = parseProps('ProfilePageSchema', profilePageZodSchema, Astro.props, Astro.url.pathname);

const mainEntity: Record<string, any> = {
  '@type': mainEntityType,
  ...(id && { '@id': id }),
  name,
  ...(url && { url }),
  ...(alternateName && { alternateName }),
  ...(identifier && { identifier }),
  ...(jobTitle && { jobTitle }),
  ...(worksFor && { worksFor: typeof worksFor === 'string' ? { '@type': 'Organization', name: worksFor } : buildReference(worksFor, 'Organization') }),
  ...(knowsAbout && { knowsAbout }),
  ...(imageUrl && { image: imageUrl }),
  ...(description && { description }),
  ...(sameAs && { sameAs }),
};

// `publishingPrinciples` is a CreativeWork / Organization property, not a Person property.
const profileSchema: Record<string, any> = {
  '@type': 'ProfilePage',
  ...(dateCreated && { dateCreated }),
  ...(dateModified && { dateModified }),
  ...(publishingPrinciples && { publishingPrinciples }),
  mainEntity,
};
---
<Schema item={profileSchema as ProfilePage} changefreq={changefreq} priority={priority} />
