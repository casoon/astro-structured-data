---
import type { ProfilePage } from 'schema-dts';
import Schema from './Schema.astro';
import { profilePageZodSchema, type ProfilePageProps } from '../zod';
import { parseProps } from '../utils/validate';

type Props = ProfilePageProps;

const {
  changefreq,
  priority,
  name,
  description,
  imageUrl,
  sameAs,
  publishingPrinciples,
} = parseProps('ProfilePageSchema', profilePageZodSchema, Astro.props, Astro.url.pathname);

const profileSchema: ProfilePage = {
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name,
    ...(imageUrl && { image: imageUrl }),
    ...(description && { description }),
    ...(sameAs && { sameAs }),
    ...(publishingPrinciples && { publishingPrinciples })
  }
};
---
<Schema item={profileSchema} changefreq={changefreq} priority={priority} />
