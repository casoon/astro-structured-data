---
import type { Event } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { eventZodSchema, type EventProps } from '../zod';
import { parseProps } from '../utils/validate';
import { pageUrl } from '../utils/meta';

type Props = EventProps;

const page = Astro.url.pathname;
const {
  changefreq,
  priority,
  name,
  startDate,
  endDate,
  description,
  imageUrl,
  url,
  locationName,
  locationAddress,
  onlineUrl,
  attendanceMode = 'Offline',
  status = 'Scheduled',
  price,
  priceCurrency,
  availability = 'InStock',
  organizer,
  performer,
} = parseProps('EventSchema', eventZodSchema, Astro.props, page);

const attendanceModeMap = {
  Offline: 'https://schema.org/OfflineEventAttendanceMode',
  Online: 'https://schema.org/OnlineEventAttendanceMode',
  Mixed: 'https://schema.org/MixedEventAttendanceMode',
};

const statusMap = {
  Scheduled: 'https://schema.org/EventScheduled',
  Cancelled: 'https://schema.org/EventCancelled',
  Postponed: 'https://schema.org/EventPostponed',
  Rescheduled: 'https://schema.org/EventRescheduled',
};

// The schema guarantees the venue (Offline/Mixed) and the stream URL (Online/Mixed).
const place = locationName && locationAddress
  ? {
      '@type': 'Place',
      name: locationName,
      address: {
        '@type': 'PostalAddress',
        streetAddress: locationAddress.streetAddress,
        addressLocality: locationAddress.addressLocality,
        ...(locationAddress.addressRegion && { addressRegion: locationAddress.addressRegion }),
        postalCode: locationAddress.postalCode,
        addressCountry: locationAddress.addressCountry,
      },
    }
  : undefined;
const virtualLocation = onlineUrl ? { '@type': 'VirtualLocation', url: onlineUrl } : undefined;

const eventSchema: Event = {
  '@type': 'Event',
  name,
  startDate,
  ...(endDate && { endDate }),
  ...(description && { description }),
  ...(imageUrl && { image: Array.isArray(imageUrl) ? imageUrl : [imageUrl] }),
  ...(url && { url }),
  eventAttendanceMode: attendanceModeMap[attendanceMode] as any,
  eventStatus: statusMap[status] as any,
  location: place && virtualLocation ? [place, virtualLocation] : (place ?? virtualLocation),
  // The schema guarantees price and priceCurrency are set together (price 0 = free event).
  ...(price !== undefined && {
    offers: {
      '@type': 'Offer',
      price,
      priceCurrency,
      availability: `https://schema.org/${availability}`,
      url: url ?? pageUrl(page, getGlobalConfig().siteUrl),
    }
  }),
  ...(organizer && {
    organizer: {
      '@type': 'Organization',
      name: organizer.name,
      ...(organizer.url && { url: organizer.url }),
    }
  }),
  ...(performer && {
    performer: {
      '@type': 'Person',
      name: performer.name,
      ...(performer.url && { url: performer.url }),
    }
  }),
} as Event;
---
<Schema item={eventSchema} changefreq={changefreq} priority={priority} />
