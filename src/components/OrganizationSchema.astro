---
import type { Organization } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { organizationZodSchema, type OrganizationProps } from '../zod';
import { fail, parseProps } from '../utils/validate';

type Props = OrganizationProps;

const page = Astro.url.pathname;
const {
  changefreq,
  priority,
  name,
  url,
  logoUrl,
  sameAs,
  telephone,
  email,
  address,
} = parseProps('OrganizationSchema', organizationZodSchema, Astro.props, page);

const globalConfig = getGlobalConfig();
const resolvedName = name ?? globalConfig.defaultArticlePublisher?.name;
if (!resolvedName) {
  fail('OrganizationSchema', page, 'Missing organization name: set the "name" prop or defaultArticlePublisher.name');
}
const resolvedLogo = logoUrl ?? globalConfig.defaultArticlePublisher?.logo?.url;

const orgSchema = {
  '@type': 'Organization',
  name: resolvedName,
  url: url ?? globalConfig.siteUrl,
  ...(resolvedLogo && {
    logo: {
      '@type': 'ImageObject',
      url: resolvedLogo,
    },
  }),
  ...(sameAs && { sameAs }),
  ...(telephone && { telephone }),
  ...(email && { email }),
  ...(address && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: address.streetAddress,
      addressLocality: address.addressLocality,
      ...(address.addressRegion && { addressRegion: address.addressRegion }),
      postalCode: address.postalCode,
      addressCountry: address.addressCountry,
    }
  })
} satisfies Organization;
---
<Schema item={orgSchema} changefreq={changefreq} priority={priority} />
