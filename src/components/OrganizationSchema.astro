---
import type { Organization } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { organizationZodSchema, type OrganizationProps } from '../zod';
import { fail, parseProps } from '../utils/validate';
import { buildReference, buildReferences } from '../utils/reference';

type Props = OrganizationProps;

const page = Astro.url.pathname;
const {
  changefreq,
  priority,
  name,
  alternateName,
  legalName,
  description,
  id,
  url,
  logoUrl,
  foundingDate,
  vatID,
  taxID,
  knowsAbout,
  areaServed,
  contactPoint,
  sameAs,
  telephone,
  email,
  address,
  parentOrganization,
  subOrganization,
} = parseProps('OrganizationSchema', organizationZodSchema, Astro.props, page);

const globalConfig = getGlobalConfig();
const resolvedName = name ?? globalConfig.defaultArticlePublisher?.name;
if (!resolvedName) {
  fail('OrganizationSchema', page, 'Missing organization name: set the "name" prop or defaultArticlePublisher.name');
}
const resolvedLogo = logoUrl ?? globalConfig.defaultArticlePublisher?.logo?.url;
// The default @id only belongs to the default publisher, not to an organization named via props.
const resolvedId = id ?? (name ? undefined : globalConfig.defaultArticlePublisher?.id);

const orgSchema = {
  '@type': 'Organization',
  name: resolvedName,
  ...(alternateName && { alternateName }),
  ...(legalName && { legalName }),
  ...(description && { description }),
  ...(resolvedId && { '@id': resolvedId }),
  url: url ?? globalConfig.siteUrl,
  ...(resolvedLogo && {
    logo: {
      '@type': 'ImageObject',
      url: resolvedLogo,
    },
  }),
  ...(foundingDate && { foundingDate }),
  ...(vatID && { vatID }),
  ...(taxID && { taxID }),
  ...(knowsAbout && { knowsAbout }),
  ...(sameAs && { sameAs }),
  ...(telephone && { telephone }),
  ...(email && { email }),
  ...(address && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: address.streetAddress,
      addressLocality: address.addressLocality,
      ...(address.addressRegion && { addressRegion: address.addressRegion }),
      postalCode: address.postalCode,
      addressCountry: address.addressCountry,
    }
  })
} satisfies Organization;
type ServedArea = string | { type?: string; name: string; id?: string; url?: string };
const buildServedArea = (area: ServedArea) => typeof area === 'string' ? area : {
  '@type': area.type ?? 'Place',
  ...(area.id && { '@id': area.id }),
  name: area.name,
  ...(area.url && { url: area.url }),
};
const buildContactPoint = (cp: any) => ({
  '@type': 'ContactPoint',
  contactType: cp.contactType,
  ...(cp.telephone && { telephone: cp.telephone }),
  ...(cp.email && { email: cp.email }),
  ...(cp.availableLanguage && { availableLanguage: cp.availableLanguage }),
  ...(cp.areaServed && { areaServed: cp.areaServed }),
});
Object.assign(orgSchema, {
  ...(areaServed && { areaServed: Array.isArray(areaServed) ? areaServed.map(buildServedArea) : buildServedArea(areaServed) }),
  ...(contactPoint && { contactPoint: Array.isArray(contactPoint) ? contactPoint.map(buildContactPoint) : buildContactPoint(contactPoint) }),
  ...(parentOrganization && { parentOrganization: buildReference(parentOrganization, 'Organization') }),
  ...(subOrganization && { subOrganization: buildReferences(subOrganization, 'Organization') }),
});
---
<Schema item={orgSchema} changefreq={changefreq} priority={priority} />
