---
import type { FAQPage } from 'schema-dts';
import Schema from './Schema.astro';
import { faqZodSchema, type FAQProps } from '../zod';
import { parseProps } from '../utils/validate';

type Props = FAQProps;

const { changefreq, priority, questions } = parseProps('FAQSchema', faqZodSchema, Astro.props, Astro.url.pathname);

const faqSchema: FAQPage = {
  '@type': 'FAQPage',
  mainEntity: questions.map(qa => ({
    '@type': 'Question',
    name: qa.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: qa.answer,
    }
  }))
};
---
<Schema item={faqSchema} changefreq={changefreq} priority={priority} />
