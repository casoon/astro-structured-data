---
import type { JobPosting } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { jobPostingZodSchema, type JobPostingProps } from '../zod';
import { fail, parseProps } from '../utils/validate';

type Props = JobPostingProps;

const page = Astro.url.pathname;
const {
  changefreq,
  priority,
  title,
  description,
  datePosted,
  validThrough,
  employmentType,
  hiringOrganizationName,
  hiringOrganizationUrl,
  hiringOrganizationLogo,
  jobLocation,
  baseSalary,
  identifier,
  directApply,
  jobLocationType,
  applicantLocationRequirements,
} = parseProps('JobPostingSchema', jobPostingZodSchema, Astro.props, page);

const globalConfig = getGlobalConfig();
const organizationName = hiringOrganizationName ?? globalConfig.defaultArticlePublisher?.name;
if (!organizationName) {
  fail('JobPostingSchema', page, 'Missing hiring organization: set "hiringOrganizationName" or defaultArticlePublisher.name');
}
const organizationLogo = hiringOrganizationLogo ?? globalConfig.defaultArticlePublisher?.logo?.url;

const jobSchema: JobPosting = {
  '@type': 'JobPosting',
  title,
  description,
  datePosted,
  ...(validThrough && { validThrough }),
  ...(employmentType && { employmentType }),
  hiringOrganization: {
    '@type': 'Organization',
    name: organizationName,
    url: hiringOrganizationUrl ?? globalConfig.siteUrl,
    ...(organizationLogo && { logo: organizationLogo }),
  },
  ...(jobLocation && {
    jobLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        streetAddress: jobLocation.streetAddress,
        addressLocality: jobLocation.addressLocality,
        ...(jobLocation.addressRegion && { addressRegion: jobLocation.addressRegion }),
        postalCode: jobLocation.postalCode,
        addressCountry: jobLocation.addressCountry,
      }
    }
  }),
  ...(baseSalary && {
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: baseSalary.currency,
      value: {
        '@type': 'QuantitativeValue',
        value: baseSalary.value,
        unitText: baseSalary.unit,
      }
    }
  }),
  ...(identifier && {
    identifier: {
      '@type': 'PropertyValue',
      name: identifier.name,
      value: identifier.value,
    }
  }),
  ...(directApply !== undefined && { directApply }),
  ...(jobLocationType && { jobLocationType }),
  ...(applicantLocationRequirements && {
    applicantLocationRequirements: Array.isArray(applicantLocationRequirements)
      ? applicantLocationRequirements.map(r => ({ '@type': 'Country', name: r }))
      : { '@type': 'Country', name: applicantLocationRequirements },
  }),
} as JobPosting;
---
<Schema item={jobSchema} changefreq={changefreq} priority={priority} />
