---
import { z } from 'zod';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import type { SitemapProps } from '../zod';
import { registerSchema } from '../utils/graph';
import { collectSitemapHints, serializeJsonLd, sitemapAttributes, stripNonSchemaKeys } from '../utils/json-ld';
import { parseProps } from '../utils/validate';

type Props = { item: Record<string, any> } & SitemapProps;

const propsSchema = z.object({
  item: z.looseObject({
    '@type': z.union([z.string().min(1), z.array(z.string().min(1)).min(1)]),
  }),
});

const page = Astro.url.pathname;
const { item: rawItem, changefreq, priority } = parseProps('Schema', propsSchema, Astro.props, page);

// Sitemap hints ride along on the item (for the graph and the middleware) and are
// stripped from the JSON-LD output. Hints on the item and as props must agree.
const hints = collectSitemapHints([rawItem, { changefreq, priority }]);
const item: Record<string, any> = { ...rawItem, ...hints };
registerSchema(Astro.locals, item, page);

const useGraph = getGlobalConfig().useGraph ?? false;
const jsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  ...stripNonSchemaKeys(item),
});
const sitemapAttrs = sitemapAttributes(hints);
---
{!useGraph && <script is:inline type="application/ld+json" {...sitemapAttrs} set:html={jsonLd} />}
