---
import Schema from './Schema.astro';
import { recipeZodSchema, type RecipeProps } from '../zod';
import { parseProps } from '../utils/validate';
import { buildReference, buildReferences } from '../utils/reference';

type Props = RecipeProps;

const {
  id,
  isPartOf,
  hasPart,
  changefreq,
  priority,
  name,
  description,
  imageUrl,
  authorName,
  authorType = 'Person',
  authorId,
  prepTime,
  cookTime,
  totalTime,
  recipeYield,
  recipeCategory,
  recipeCuisine,
  calories,
  ingredients,
  instructions,
  ratingValue,
  reviewCount,
  datePublished,
} = parseProps('RecipeSchema', recipeZodSchema, Astro.props, Astro.url.pathname);

const buildAuthor = (aName: string) => ({
  '@type': authorType,
  name: aName,
  ...(authorId ? { '@id': authorId } : {}),
});

const formattedInstructions = instructions.map((step) => {
  if (typeof step === 'string') {
    return {
      '@type': 'HowToStep',
      text: step,
    };
  }
  return {
    '@type': 'HowToStep',
    text: step.text,
    ...(step.name ? { name: step.name } : {}),
    ...(step.imageUrl ? { image: step.imageUrl } : {}),
    ...(step.url ? { url: step.url } : {}),
  };
});

const recipeSchema: Record<string, any> = {
  '@type': 'Recipe',
  ...(id && { '@id': id }),
  name,
  description,
  image: Array.isArray(imageUrl) ? imageUrl : [imageUrl],
  author: Array.isArray(authorName)
    ? authorName.map(buildAuthor)
    : buildAuthor(authorName),
  recipeIngredient: ingredients,
  recipeInstructions: formattedInstructions,
};

if (prepTime) recipeSchema.prepTime = prepTime;
if (cookTime) recipeSchema.cookTime = cookTime;
if (totalTime) recipeSchema.totalTime = totalTime;
if (recipeYield !== undefined) recipeSchema.recipeYield = recipeYield.toString();
if (recipeCategory) recipeSchema.recipeCategory = recipeCategory;
if (recipeCuisine) recipeSchema.recipeCuisine = recipeCuisine;
if (datePublished) recipeSchema.datePublished = datePublished;

if (calories !== undefined) {
  recipeSchema.nutrition = {
    '@type': 'NutritionInformation',
    calories: calories.toString().includes('calories') ? calories.toString() : `${calories} calories`,
  };
}

// The schema guarantees ratingValue and reviewCount are set together.
if (ratingValue !== undefined && reviewCount !== undefined) {
  recipeSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: ratingValue.toString(),
    reviewCount: reviewCount.toString(),
  };
}
Object.assign(recipeSchema, {
  ...(isPartOf && { isPartOf: buildReferences(isPartOf, 'CreativeWork') }),
  ...(hasPart && { hasPart: hasPart.map((part) => buildReference(part, 'CreativeWork')) }),
});
---
<Schema item={recipeSchema} changefreq={changefreq} priority={priority} />
