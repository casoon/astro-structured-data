---
import type { CollectionPage } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { collectionPageZodSchema, type CollectionPageProps } from '../zod';
import { parseProps } from '../utils/validate';
import { pageUrl } from '../utils/meta';

type Props = CollectionPageProps;

const page = Astro.url.pathname;
const { changefreq, priority, name, description, products } = parseProps('CollectionPageSchema', collectionPageZodSchema, Astro.props, page);

const collectionSchema: CollectionPage = {
  '@type': 'CollectionPage',
  name,
  description,
  url: pageUrl(page, getGlobalConfig().siteUrl),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: products.length,
    itemListElement: products.map((prod, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Product',
        name: prod.name,
        url: prod.url,
        ...(prod.imageUrl && { image: prod.imageUrl }),
        // The schema guarantees price and priceCurrency are set together.
        ...(prod.price !== undefined && {
          offers: {
            '@type': 'Offer',
            price: prod.price,
            priceCurrency: prod.priceCurrency,
          },
        }),
      },
    }))
  }
};
---
<Schema item={collectionSchema} changefreq={changefreq} priority={priority} />
