---
// SchemaGraph.astro
// Marks where the page's @graph block goes (graph mode). The integration's middleware fills
// it in after the whole page has rendered, so schema components may appear anywhere on the
// page — including in components that await data before rendering their schema.
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { GRAPH_PLACEHOLDER } from '../utils/json-ld';

const useGraph = getGlobalConfig().useGraph ?? false;
---
{useGraph && <Fragment set:html={GRAPH_PLACEHOLDER} />}
