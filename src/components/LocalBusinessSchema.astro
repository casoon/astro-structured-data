---
import type { LocalBusiness } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { localBusinessZodSchema, type LocalBusinessProps } from '../zod';
import { fail, parseProps } from '../utils/validate';

type Props = LocalBusinessProps;

const page = Astro.url.pathname;
const props = parseProps('LocalBusinessSchema', localBusinessZodSchema, Astro.props, page);
// Site-wide defaults are validated against the same schema when the integration is set up.
const defaults = getGlobalConfig().defaultLocalBusiness ?? {};

const name = props.name ?? defaults.name;
const url = props.url ?? defaults.url;
const description = props.description ?? defaults.description;
const imageUrl = props.imageUrl ?? defaults.imageUrl;
const telephone = props.telephone ?? defaults.telephone;
const email = props.email ?? defaults.email;
const priceRange = props.priceRange ?? defaults.priceRange;
const address = props.address ?? defaults.address;
const geo = props.geo ?? defaults.geo;
const openingHours = props.openingHours ?? defaults.openingHours;
const sameAs = props.sameAs ?? defaults.sameAs;

if (!name) {
  fail('LocalBusinessSchema', page, 'Missing business name: set the "name" prop or defaultLocalBusiness.name');
}

const localBusinessSchema = {
  '@type': 'LocalBusiness',
  name,
  ...(url && { url }),
  ...(description && { description }),
  ...(imageUrl && { image: imageUrl }),
  ...(telephone && { telephone }),
  ...(email && { email }),
  ...(priceRange && { priceRange }),
  ...(address && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: address.streetAddress,
      addressLocality: address.addressLocality,
      ...(address.addressRegion && { addressRegion: address.addressRegion }),
      postalCode: address.postalCode,
      addressCountry: address.addressCountry,
    }
  }),
  ...(geo && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: geo.latitude,
      longitude: geo.longitude,
    }
  }),
  ...(openingHours && { openingHours }),
  ...(sameAs && { sameAs }),
} satisfies LocalBusiness;
---
<Schema item={localBusinessSchema} changefreq={props.changefreq} priority={props.priority} />
