---
import type { WebSite } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { webSiteZodSchema, type WebSiteProps } from '../zod';
import { parseProps } from '../utils/validate';

type Props = WebSiteProps;

const { changefreq, priority, name, url, searchQueryInput } = parseProps('WebSiteSchema', webSiteZodSchema, Astro.props, Astro.url.pathname);
const siteUrl: string = url ?? getGlobalConfig().siteUrl;

const websiteSchema: WebSite = {
  '@type': 'WebSite',
  name,
  url: siteUrl,
  ...(searchQueryInput && {
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl.replace(/\/$/, '')}/?${searchQueryInput}={search_term_string}`
      },
      'query-input': `required name=${searchQueryInput}`
    } as any
  })
};
---
<Schema item={websiteSchema} changefreq={changefreq} priority={priority} />
