---
import type { WebSite } from 'schema-dts';
import Schema from './Schema.astro';
// @ts-ignore
import { getGlobalConfig } from 'virtual:astro-structured-data/config';
import { webSiteZodSchema, type WebSiteProps } from '../zod';
import { parseProps } from '../utils/validate';
import { buildReference } from '../utils/reference';

type Props = WebSiteProps;

const { changefreq, priority, name, alternateName, description, inLanguage, publisher, url, id, searchQueryInput } = parseProps('WebSiteSchema', webSiteZodSchema, Astro.props, Astro.url.pathname);
const siteUrl: string = url ?? getGlobalConfig().siteUrl;

const websiteSchema: Record<string, any> = {
  '@type': 'WebSite',
  ...(id && { '@id': id }),
  name,
  ...(alternateName && { alternateName }),
  ...(description && { description }),
  ...(inLanguage && { inLanguage }),
  url: siteUrl,
  ...(publisher && { publisher: buildReference(publisher, 'Organization') }),
  ...(searchQueryInput && {
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl.replace(/\/$/, '')}/?${searchQueryInput}={search_term_string}`
      },
      'query-input': 'required name=search_term_string'
    } as any
  })
};
---
<Schema item={websiteSchema as WebSite} changefreq={changefreq} priority={priority} />
