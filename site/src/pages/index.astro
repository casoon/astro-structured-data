---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
// Animated SVGs built with castwright from captures/build*.terminal.yaml (real builds, see
// capture.sh). The narrow scene (54 columns, without the meta tags) keeps the text readable on phones.
import buildNarrowSvg from '../../captures/build-narrow.svg?url';
import buildSvg from '../../captures/build.svg?url';
import Diagram from '../components/Diagram.astro';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const pageCode = `---
import { ArticleSchema } from '@casoon/astro-structured-data/components';
const { post } = Astro.props;
---
<ArticleSchema
  title={post.data.title}
  description={post.data.description}
  datePublished={post.data.date}
  authorName={post.data.author}
  imageUrl={post.data.cover}
/>`;

// The data of examples/blog-post.astro, product.astro and online-event.astro.
const previews = [
  {
    component: 'ArticleSchema',
    type: 'BlogPosting',
    doc: 'docs/components/article/',
    path: 'example.com › blog',
    title: 'Structured data for Astro sites',
    meta: ['Sep 10, 2026', 'Jane Doe', '4 min read'],
    text: 'How JSON-LD is generated from typed, validated component props.',
  },
  {
    component: 'ProductSchema',
    type: 'Product',
    doc: 'docs/components/product/',
    path: 'example.com › shop',
    title: 'Super Gadget – Gadget Co',
    rating: { value: '4.5', count: '128' },
    meta: ['€29.99', 'In stock'],
    text: 'The best gadget ever',
  },
  {
    component: 'EventSchema',
    type: 'Event',
    doc: 'docs/components/event/',
    path: 'example.com › events',
    title: 'Astro Live Webinar',
    meta: ['Tue, Oct 20, 17:00', 'Online', 'Free'],
    text: 'Structured data in Astro, live with Q&A.',
  },
];

const groups = [
  {
    label: 'Content',
    items: [
      ['ArticleSchema', 'article'],
      ['RecipeSchema', 'recipe'],
      ['VideoSchema', 'video'],
      ['FAQSchema', 'faq'],
    ],
  },
  {
    label: 'Shops and apps',
    items: [
      ['ProductSchema', 'product'],
      ['CollectionPageSchema', 'collection-page'],
      ['SoftwareAppSchema', 'software-app'],
    ],
  },
  {
    label: 'Businesses',
    items: [
      ['LocalBusinessSchema', 'local-business'],
      ['OrganizationSchema', 'organization'],
      ['EventSchema', 'event'],
      ['JobPostingSchema', 'job-posting'],
    ],
  },
  {
    label: 'Site structure',
    items: [
      ['WebSiteSchema', 'website'],
      ['WebPageSchema', 'webpage'],
      ['ProfilePageSchema', 'profile-page'],
      ['BreadcrumbSchema', 'breadcrumbs'],
      ['AutoBreadcrumbSchema', 'breadcrumbs'],
    ],
  },
];
---

<Base>
  <Hero
    title="Rich results, checked before you ship."
    lead="Put a component on the page and pass the data it already has. astro-structured-data writes the schema.org JSON-LD and meta tags that search engines read, and stops the build when the data would not be valid."
  >
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/astro-structured-data' },
        { label: 'pnpm', command: 'pnpm add @casoon/astro-structured-data' },
        { label: 'yarn', command: 'yarn add @casoon/astro-structured-data' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>npm {config.version}</Badge>
      <Badge>Astro 5 · 6 · 7</Badge>
      <Badge tone="accent">0 kB client JS</Badge>
    </Badges>
    <picture slot="output">
      <source media="(max-width: 640px)" srcset={buildNarrowSvg} width="477.6" height="584" />
      <img
        class="terminal-demo"
        src={buildSvg}
        width="561.6"
        height="530"
        alt="Terminal: a blog post page uses ArticleSchema with title 'Hello, Astro', description, datePublished 2026-10-01, author Ada Lovelace, an image and the publisher. astro build builds the page. The generated head contains canonical, description, author, og:title, og:description, og:url, og:image, og:site_name, og:type article, article:published_time, article:modified_time and the twitter tags with summary_large_image. The JSON-LD is a BlogPosting with headline, dates, mainEntityOfPage, author, publisher and image. With datePublished changed to 01.10.2026 the build stops: '<ArticleSchema> on /blog/hello-astro/ received invalid props: Must be an ISO 8601 date (YYYY-MM-DD) or date-time, or a Date, at datePublished'. On narrow screens the meta tags are left out."
      />
    </picture>
  </Hero>

  <section class="section" aria-labelledby="results-heading">
    <p class="cp-label">What it is for</p>
    <h2 id="results-heading">From the data on your page to a richer search result</h2>
    <p class="intro">
      Dates, prices, ratings and venues only show up in search when the page describes them as
      schema.org data. The components turn your props into exactly that.
    </p>
    <ul class="previews">
      {
        previews.map((p) => (
          <li class="preview">
            <a class="source" href={url(p.doc)}>
              <code>&lt;{p.component}&gt;</code>
              <span aria-hidden="true">→</span>
              <span>{p.type}</span>
            </a>
            <div class="result">
              <p class="path">{p.path}</p>
              <p class="title">{p.title}</p>
              {p.rating && (
                <p class="rating">
                  <span class="stars" aria-hidden="true">★★★★☆</span>
                  <span>
                    {p.rating.value} ({p.rating.count} reviews)
                  </span>
                </p>
              )}
              <p class="meta">
                {p.meta.map((m) => (
                  <span>{m}</span>
                ))}
              </p>
              <p class="text">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="note">
      Illustration with the data of three examples from the <a href={url('showcase/')}>showcase</a>.
      Whether and how a rich result appears is decided by the search engine.
    </p>
  </section>

  <Features
    heading="Why it exists"
    items={[
      {
        title: 'Hand-written JSON-LD fails silently',
        body: 'A German date, a € sign instead of EUR or a missing field raises no error. The markup is simply ignored, and you notice weeks later in Search Console.',
      },
      {
        title: 'Your pages already have the data',
        body: 'Titles, dates, prices and addresses sit in frontmatter, content collections or your CMS. Pass them as props instead of keeping a second copy as JSON.',
      },
      {
        title: 'Errors surface in the build',
        body: 'Every component checks its props. Wrong data stops the build with the component, the page and the field, so it never reaches production.',
      },
    ]}
  />

  <section class="section" aria-labelledby="how-heading">
    <p class="cp-label">How it works</p>
    <h2 id="how-heading">Props in, JSON-LD and meta tags out</h2>
    <p class="intro">
      Each component validates its props and writes a JSON-LD block. Optionally, all schemas of a
      page are merged into one <code>@graph</code>, and canonical, Open Graph and Twitter tags are
      derived from the same data. Nothing is added to the JavaScript your visitors download.
    </p>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 360, height: 1000 }} />
    <div class="links">
      <Button href={url('docs/guides/validation/')} variant="secondary">Validation rules</Button>
      <Button href={url('docs/guides/meta-tags/')} variant="secondary">Meta tags</Button>
      <Button href={url('docs/guides/graph-mode/')} variant="secondary">Graph mode</Button>
    </div>
  </section>

  <section class="section" aria-labelledby="types-heading">
    <p class="cp-label">Components</p>
    <h2 id="types-heading">One component for each kind of page</h2>
    <p class="intro">
      Blogs, shops, local businesses, events, job boards: each component knows which fields its
      rich result needs.
      The generic <a href={url('docs/components/schema/')}><code>&lt;Schema&gt;</code></a> covers any other schema.org type.
    </p>
    <div class="groups">
      {
        groups.map((g) => (
          <div class="group">
            <h3>{g.label}</h3>
            <ul>
              {g.items.map(([name, slug]) => (
                <li>
                  <a href={url(`docs/components/${slug}/`)}>{name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <Facts
    items={[
      { value: '18', label: 'Astro components, one per schema type plus generic and graph' },
      { value: '16', label: 'Zod schemas for content collections and forms' },
      { value: '277', label: 'tests, including real static, dev and SSR builds' },
      { value: '0 kB', label: 'client JavaScript added to your pages' },
    ]}
  />

  <Quickstart
    lead="Register the integration once, then put the components on your pages. The documentation covers every component, prop and option."
    steps={[
      'Install the package and add <code>structuredData()</code> to the integrations in <code>astro.config.mjs</code>, with <code>site</code> set.',
      'Import a component from <code>@casoon/astro-structured-data/components</code> and pass your data as props.',
      'Run <code>astro build</code>: wrong data stops the build, missing recommended fields are listed.',
    ]}
  >
    <CodeBlock code={pageCode} lang="astro" title="src/layouts/Post.astro" label="Page" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'What happens if I pass invalid data to a component?',
        a: 'The build fails with the component, the page and the offending field, for example a date that is not ISO 8601 or a currency that is not an ISO 4217 code. The markup never reaches production silently wrong.',
      },
      {
        q: 'Does this add any JavaScript to the pages my visitors load?',
        a: 'No. Every component runs at build time (or on the server in SSR) and only writes a JSON-LD script tag and meta tags into the HTML.',
      },
      {
        q: 'What if I leave out a field Google recommends but does not require?',
        a: 'The build still succeeds. After astro build, the integration lists each missing recommended field once per type, so you can decide whether to add it.',
      },
      {
        q: 'Can I combine several schemas on one page into a single JSON-LD block?',
        a: 'Yes. With useGraph set, all schemas of a page are merged into one @graph block wherever the SchemaGraph component is placed, instead of one script tag per component.',
      },
      {
        q: 'Which Astro and Node versions are supported?',
        a: 'Astro 5, 6 and 7, with Node 18 or later. The compatibility table in the README lists which package version matches which Astro range.',
      },
    ]}
  />
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
  }
  .section {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    max-width: 28ch;
    text-wrap: balance;
    margin: 10px 0 14px;
    color: var(--heading);
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .intro {
    max-width: 62ch;
    margin: 0 0 32px;
    font-size: 16.5px;
  }
  .note {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 13.5px;
  }
  .note a,
  .intro a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Search result illustrations */
  .previews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .preview {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }
  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-deep);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: none;
  }
  .source code {
    color: var(--accent);
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .source:hover span:last-child {
    color: var(--heading);
  }
  .result {
    padding: 18px 18px 22px;
  }
  .result p {
    margin: 0;
  }
  .path {
    color: var(--muted);
    font-size: 13px;
  }
  .title {
    margin: 4px 0 8px !important;
    color: var(--accent);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.3;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    color: var(--muted);
    font-size: 13.5px;
  }
  .meta > span + span::before {
    content: '·';
    margin: 0 8px;
  }
  .rating {
    display: flex;
    gap: 6px;
    margin-bottom: 2px !important;
    color: var(--muted);
    font-size: 13.5px;
  }
  .stars {
    color: var(--brand);
    letter-spacing: 1px;
  }
  .text {
    margin-top: 8px !important;
    font-size: 14.5px;
  }

  /* Component groups */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 28px 32px;
  }
  .group h3 {
    margin: 0 0 12px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--heading);
    font-size: 15px;
    font-weight: 600;
  }
  .group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .group a {
    display: inline-block;
    padding: 5px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: none;
  }
  .group a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
