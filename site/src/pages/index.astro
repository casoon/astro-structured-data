---
import { readdir, readFile } from 'node:fs/promises';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  ElementList,
  Features,
  Faq,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
  SectionIntro,
  Split,
  StatBand,
  Tradeoffs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
// Animated SVGs built with castwright from captures/build*.terminal.yaml (real builds, see
// capture.sh). The narrow scene (54 columns, without the meta tags) keeps the text readable on phones.
import buildNarrowSvg from '../../captures/build-narrow.svg?url';
import buildSvg from '../../captures/build.svg?url';
import Diagram from '../components/Diagram.astro';
import InvalidEvent from '../../../examples/invalid-event.astro';
import { renderExample } from '../render';

// Key figures, read from the package so they cannot drift.
const componentCount = (await readdir('../src/components')).filter((f) => f.endsWith('.astro')).length;
const zodCount = (await readFile('../src/zod.ts', 'utf8')).match(/^export const \w+ZodSchema\b/gm)?.length ?? 0;
const pkg = JSON.parse(await readFile('../package.json', 'utf8'));
const astroMajors = [...pkg.peerDependencies.astro.matchAll(/\^(\d+)/g)].map((m) => m[1]);

// The real error examples/invalid-event.astro stops the build with, rendered by the package.
const invalid = await renderExample(InvalidEvent as AstroComponentFactory, '/events/meetup/');
if (invalid.ok) throw new Error('examples/invalid-event.astro is expected to fail validation');
const invalidSource = `<EventSchema
  name="Tech Meetup Berlin"
  startDate="15.06.2026"
  attendanceMode="Offline"
  locationName="Hub Berlin"
  price={10}
  priceCurrency="euro"
/>`;

const collectionCode = `// src/content.config.ts
import { defineCollection } from 'astro:content';
import { glob } from 'astro/loaders';
import { eventZodSchema } from '@casoon/astro-structured-data/zod';

const events = defineCollection({
  loader: glob({ pattern: '**/*.md', base: './src/content/events' }),
  schema: eventZodSchema,
});`;

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const pageCode = `---
import { ArticleSchema } from '@casoon/astro-structured-data/components';
const { post } = Astro.props;
---
<ArticleSchema
  title={post.data.title}
  description={post.data.description}
  datePublished={post.data.date}
  authorName={post.data.author}
  imageUrl={post.data.cover}
/>`;

// The data of examples/blog-post.astro, product.astro and online-event.astro.
const previews = [
  {
    component: 'ArticleSchema',
    type: 'BlogPosting',
    doc: 'docs/components/article/',
    path: 'example.com › blog',
    title: 'Structured data for Astro sites',
    meta: ['Sep 10, 2026', 'Jane Doe', '4 min read'],
    text: 'How JSON-LD is generated from typed, validated component props.',
  },
  {
    component: 'ProductSchema',
    type: 'Product',
    doc: 'docs/components/product/',
    path: 'example.com › shop',
    title: 'Super Gadget – Gadget Co',
    rating: { value: '4.5', count: '128' },
    meta: ['€29.99', 'In stock'],
    text: 'The best gadget ever',
  },
  {
    component: 'EventSchema',
    type: 'Event',
    doc: 'docs/components/event/',
    path: 'example.com › events',
    title: 'Astro Live Webinar',
    meta: ['Tue, Oct 20, 17:00', 'Online', 'Free'],
    text: 'Structured data in Astro, live with Q&A.',
  },
];

// What a complete site gets: site-wide data once, then one component per kind of page.
const siteWide = [
  ['WebSiteSchema', 'website', 'WebSite', 'The site name and alternate name Google shows above results, language and publisher.'],
  ['OrganizationSchema', 'organization', 'Organization', 'Who is behind the site: legal name, logo, contact points, profiles on other platforms.'],
  ['LocalBusinessSchema', 'local-business', 'LocalBusiness', 'Address, phone, opening hours, service area and rating of a business with a location.'],
  ['AutoBreadcrumbSchema', 'breadcrumbs', 'BreadcrumbList', 'Where a page sits in the site, shown as a trail instead of the bare URL.'],
];
const pageTypes = [
  ['Blog post, news', 'ArticleSchema', 'article', 'Headline, author, dates, image'],
  ['Product page', 'ProductSchema', 'product', 'Price, stock, rating, shipping, returns'],
  ['Category, list', 'CollectionPageSchema', 'collection-page', 'The items a page lists'],
  ['Event', 'EventSchema', 'event', 'Date, venue or stream, tickets'],
  ['Job ad', 'JobPostingSchema', 'job-posting', 'Salary, location, remote, deadline'],
  ['Recipe', 'RecipeSchema', 'recipe', 'Times, ingredients, steps, rating'],
  ['Video', 'VideoSchema', 'video', 'Thumbnail, duration, upload date'],
  ['FAQ', 'FAQSchema', 'faq', 'Questions and answers'],
  ['App, software', 'SoftwareAppSchema', 'software-app', 'Platform, price, rating'],
  ['Author, team member', 'ProfilePageSchema', 'profile-page', 'The person, their role and expertise'],
  ['About, contact, any page', 'WebPageSchema', 'webpage', 'Page type, breadcrumb, dates'],
  ['Anything else', 'Schema', 'schema', 'Any schema.org type, as given'],
];

const configCode = `// astro.config.mjs
import { defineConfig } from 'astro/config';
import structuredData from '@casoon/astro-structured-data';

export default defineConfig({
  site: 'https://example.com',
  integrations: [structuredData({ generateMeta: true, siteName: 'Example Blog' })],
});`;

const layoutCode = `---
// src/layouts/Base.astro – once, on every page
import { WebSiteSchema, OrganizationSchema, AutoBreadcrumbSchema }
  from '@casoon/astro-structured-data/components';
---
<WebSiteSchema name="Example Blog" />
<OrganizationSchema logoUrl="/logo.png" sameAs={['https://github.com/example']} />
<AutoBreadcrumbSchema />`;

---

<Base>
  <Hero
    title="Structured data for your whole Astro site."
    lead="Google, Bing and AI assistants read schema.org data to understand what a page is: an article and its author, a product and its price, a business and its opening hours. This integration equips every page of an Astro site with it, one component per kind of page, and checks the data in the build."
  >
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/astro-structured-data' },
        { label: 'pnpm', command: 'pnpm add @casoon/astro-structured-data' },
        { label: 'yarn', command: 'yarn add @casoon/astro-structured-data' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>npm {config.version}</Badge>
      <Badge>Astro 5 · 6 · 7</Badge>
      <Badge>0 kB client JS</Badge>
    </Badges>
    <picture slot="output">
      <source media="(max-width: 640px)" srcset={buildNarrowSvg} width="477.6" height="584" />
      <img
        class="terminal-demo"
        src={buildSvg}
        width="561.6"
        height="530"
        alt="Terminal: a blog post page uses ArticleSchema with title 'Hello, Astro', description, datePublished 2026-10-01, author Ada Lovelace, an image and the publisher. astro build builds the page. The generated head contains canonical, description, author, og:title, og:description, og:url, og:image, og:site_name, og:type article, article:published_time, article:modified_time and the twitter tags with summary_large_image. The JSON-LD is a BlogPosting with headline, dates, mainEntityOfPage, author, publisher and image. With datePublished changed to 01.10.2026 the build stops: '<ArticleSchema> on /blog/hello-astro/ received invalid props: Must be an ISO 8601 date (YYYY-MM-DD) or date-time, or a Date, at datePublished'. On narrow screens the meta tags are left out."
      />
    </picture>
  </Hero>

  <Features
    heading="What structured data is for"
    items={[
      {
        title: 'Rich results in Google',
        body: 'Prices, stock, ratings, event dates, recipe times, job details and breadcrumbs appear in search results only when the page describes them as schema.org data. Without it, the page is a plain blue link.',
      },
      {
        title: 'Who is behind the site',
        body: 'The site name, the organisation or business, its logo, address, opening hours and profiles. Search engines use this to connect every page to one publisher and to show the right name and details.',
      },
      {
        title: 'Facts machines do not have to guess',
        body: 'AI search features and assistants pull answers out of pages. JSON-LD gives them author, date, price, address or salary as data, matching what the page shows, instead of leaving them to read it from the layout.',
      },
    ]}
  />

  <section class="section" aria-labelledby="coverage-heading">
    <p class="cp-label">What your site gets</p>
    <h2 id="coverage-heading">Every page covered, from the home page to the job ad</h2>
    <p class="intro">
      A complete setup has two layers. Site-wide data goes into the base layout once. Each kind of
      page then gets the component that describes it, fed with the data the page already has:
      frontmatter, a content collection, a CMS.
    </p>

    <div class="layer">
      <h3>Once, for the whole site</h3>
      <ul class="sitewide">
        {
          siteWide.map(([name, slug, type, body]) => (
            <li>
              <a href={url(`docs/components/${slug}/`)}>
                <code>&lt;{name}&gt;</code>
                <span class="type">{type}</span>
              </a>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="layer">
      <h3>On each page, by what it is</h3>
      <ul class="pagetypes">
        {
          pageTypes.map(([kind, name, slug, body]) => (
            <li>
              <span class="kind">{kind}</span>
              <a href={url(`docs/components/${slug}/`)}><code>&lt;{name}&gt;</code></a>
              <span class="what">{body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Split
    title="Set up the site once, then each page"
    lead="Put the site-wide components into the base layout, and the page component into the layout of that kind of page. With `generateMeta`, canonical, Open Graph and Twitter tags come from the same data."
    links={[
      { label: 'Setups for blogs, shops, businesses, events and job boards', href: url('docs/guides/site-setups/') },
      { label: 'Quickstart', href: url('docs/getting-started/quickstart/') },
    ]}
  >
    <CodeBlock code={layoutCode} lang="astro" title="src/layouts/Base.astro" label="Site" />
    <CodeBlock code={pageCode} lang="astro" title="src/layouts/Post.astro" label="Page" />
  </Split>

  <section class="section" aria-labelledby="results-heading">
    <p class="cp-label">In search</p>
    <h2 id="results-heading">The same page, as a richer search result</h2>
    <p class="intro">
      Three pages from the examples, with the data their components write. This is what a search
      engine can show when it understands the page instead of only its text.
    </p>
    <ul class="previews">
      {
        previews.map((p) => (
          <li class="preview">
            <a class="source" href={url(p.doc)}>
              <code>&lt;{p.component}&gt;</code>
              <span aria-hidden="true">→</span>
              <span>{p.type}</span>
            </a>
            <div class="result">
              <p class="path">{p.path}</p>
              <p class="title">{p.title}</p>
              {p.rating && (
                <p class="rating">
                  <span class="stars" aria-hidden="true">★★★★☆</span>
                  <span>
                    {p.rating.value} ({p.rating.count} reviews)
                  </span>
                </p>
              )}
              <p class="meta">
                {p.meta.map((m) => (
                  <span>{m}</span>
                ))}
              </p>
              <p class="text">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="note">
      Illustration with the data of three examples from the <a href={url('showcase/')}>showcase</a>.
      Whether and how a rich result appears is decided by the search engine.
    </p>
  </section>

  <StatBand
    items={[
      { value: String(componentCount), label: 'Astro components, one per schema type plus generic and graph' },
      { value: String(zodCount), label: 'Zod schemas for content collections and forms' },
      { value: astroMajors.join(' · '), label: 'Astro major versions supported' },
      { value: '0 kB', label: 'client JavaScript added to your pages' },
    ]}
  />

  <SectionIntro
    title="Checked in the build, not weeks later in Search Console."
    lead="Hand-written JSON-LD fails silently: a German date or a € sign instead of EUR raises no error, the markup is just ignored. Here every prop is validated before the page is written."
  />

  <Split
    index="01"
    title="Wrong data stops the build"
    lead="Each component validates its props with Zod: ISO 8601 dates, ISO 4217 currencies, absolute URLs, fields that belong together. The error names the component, the page and every field."
    note="Output of `examples/invalid-event.astro`, rendered by the package when this page was built."
    links={[{ label: 'Validation rules', href: url('docs/guides/validation/') }]}
  >
    <CodeBlock code={invalidSource} lang="astro" title="src/pages/events/meetup.astro" label="Page" />
    <CodeBlock code={invalid.error} lang="text" title="astro build" label="Error" />
  </Split>

  <Split
    index="02"
    reverse
    title="Meta tags from the same data"
    lead="With `generateMeta`, canonical, Open Graph and Twitter tags are derived from the primary schema of the page, so title, description and image are written once."
    links={[{ label: 'Meta tags', href: url('docs/guides/meta-tags/') }]}
  >
    <ElementList
      items={[
        { term: 'canonical', body: 'The page URL, from the schema that describes the page.' },
        { term: 'og:*', body: 'Title, description, image, URL, site name and type.' },
        { term: 'article:*', body: 'Published and modified time for articles.' },
        { term: 'twitter:*', body: 'The card, with a large image when there is one.' },
      ]}
    />
  </Split>

  <Split
    index="03"
    title="The same schemas for your content"
    lead="Every component ships its Zod schema. Use it for a content collection, and wrong frontmatter is reported in the file where it is written, before a page renders it."
    links={[{ label: 'Zod schemas and content', href: url('docs/guides/content-collections/') }]}
  >
    <CodeBlock code={collectionCode} lang="ts" title="src/content.config.ts" label="Config" />
  </Split>

  <section class="section" aria-labelledby="how-heading">
    <p class="cp-label">How it works</p>
    <h2 id="how-heading">Props in, JSON-LD and meta tags out</h2>
    <p class="intro">
      Each component validates its props and writes a JSON-LD block. Optionally, all schemas of a
      page are merged into one <code>@graph</code>, and canonical, Open Graph and Twitter tags are
      derived from the same data. Nothing is added to the JavaScript your visitors download.
    </p>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 360, height: 1000 }} />
    <div class="links">
      <Button href={url('docs/guides/validation/')} variant="secondary">Validation rules</Button>
      <Button href={url('docs/guides/meta-tags/')} variant="secondary">Meta tags</Button>
      <Button href={url('docs/guides/graph-mode/')} variant="secondary">Graph mode</Button>
    </div>
  </section>

  <Tradeoffs
    title="What it does not do"
    lead="The package makes the markup correct and complete. Some things stay outside of it."
    items={[
      '**No guaranteed rich result.** Whether and how a result is enhanced is decided by the search engine.',
      '**No live check against Google.** The rules follow the documented required and recommended fields; the Rich Results Test stays the final word.',
      '**The generic component is not validated.** `<Schema>` outputs any schema.org object as given, for types without a dedicated component.',
      '**Graph mode and meta tags hold back streaming.** With either on, an on-demand page is sent in one piece once it has fully rendered.',
    ]}
  />

  <Quickstart
    lead="Register the integration once, then put the components on your pages. The documentation covers every component, prop and option."
    steps={[
      'Install the package and add <code>structuredData()</code> to the integrations in <code>astro.config.mjs</code>, with <code>site</code> set.',
      'Import a component from <code>@casoon/astro-structured-data/components</code> and pass your data as props.',
      'Run <code>astro build</code>: wrong data stops the build, missing recommended fields are listed.',
    ]}
  >
    <CodeBlock code={configCode} lang="js" title="astro.config.mjs" label="Config" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'What happens if I pass invalid data to a component?',
        a: 'The build fails with the component, the page and the offending field, for example a date that is not ISO 8601 or a currency that is not an ISO 4217 code. The markup never reaches production silently wrong.',
      },
      {
        q: 'Does this add any JavaScript to the pages my visitors load?',
        a: 'No. Every component runs at build time (or on the server in SSR) and only writes a JSON-LD script tag and meta tags into the HTML.',
      },
      {
        q: 'What if I leave out a field Google recommends but does not require?',
        a: 'The build still succeeds. After astro build, the integration lists each missing recommended field once per type, so you can decide whether to add it.',
      },
      {
        q: 'Can I combine several schemas on one page into a single JSON-LD block?',
        a: 'Yes. With useGraph set, all schemas of a page are merged into one @graph block wherever the SchemaGraph component is placed, instead of one script tag per component.',
      },
      {
        q: 'Which Astro and Node versions are supported?',
        a: 'Astro 5, 6 and 7, with Node 18 or later. The compatibility table in the README lists which package version matches which Astro range.',
      },
    ]}
  />
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
  }
  .section {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    max-width: 28ch;
    text-wrap: balance;
    margin: 10px 0 14px;
    color: var(--heading);
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .intro {
    max-width: 62ch;
    margin: 0 0 32px;
    font-size: 16.5px;
  }
  .note {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 13.5px;
  }
  .note a,
  .intro a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Search result illustrations */
  .previews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .preview {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }
  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: none;
  }
  .source code {
    color: var(--accent);
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .source:hover span:last-child {
    color: var(--heading);
  }
  .result {
    padding: 18px 18px 22px;
  }
  .result p {
    margin: 0;
  }
  .path {
    color: var(--muted);
    font-size: 13px;
  }
  .title {
    margin: 4px 0 8px !important;
    color: var(--accent);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.3;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    color: var(--muted);
    font-size: 13.5px;
  }
  .meta > span + span::before {
    content: '·';
    margin: 0 8px;
  }
  .rating {
    display: flex;
    gap: 6px;
    margin-bottom: 2px !important;
    color: var(--muted);
    font-size: 13.5px;
  }
  .stars {
    color: var(--brand);
    letter-spacing: 1px;
  }
  .text {
    margin-top: 8px !important;
    font-size: 14.5px;
  }

  /* Coverage: site-wide layer and page types */
  .layer + .layer {
    margin-top: 40px;
  }
  .layer h3 {
    margin: 0 0 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--heading);
    font-size: 15px;
    font-weight: 600;
  }
  .sitewide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sitewide li {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .sitewide a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    text-decoration: none;
  }
  .sitewide code,
  .pagetypes code {
    color: var(--accent);
    background: none;
    padding: 0;
    font-size: 13px;
  }
  .sitewide .type {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .sitewide p {
    margin: 8px 0 0;
    font-size: 14.5px;
  }
  .pagetypes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 0 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pagetypes li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2px 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14.5px;
  }
  .pagetypes .kind {
    grid-row: span 2;
    color: var(--heading);
    font-weight: 500;
  }
  .pagetypes a {
    text-decoration: none;
  }
  .pagetypes a:hover code {
    text-decoration: underline;
  }
  .pagetypes .what {
    color: var(--muted);
    font-size: 13.5px;
  }
  @media (max-width: 480px) {
    .pagetypes li {
      grid-template-columns: 1fr;
    }
    .pagetypes .kind {
      grid-row: auto;
    }
  }

</style>
