---
import {
  ArticleSchema,
  AutoBreadcrumbSchema,
  EventSchema,
  FAQSchema,
  JobPostingSchema,
  LocalBusinessSchema,
  ProductSchema,
  RecipeSchema,
  SchemaGraph,
  VideoSchema,
} from 'astro-structured-data/components';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Playground | Structured Data</title>
  <meta name="description" content="All schema components on one page, for trying out the integration and its dev toolbar." />

  <!-- LocalBusiness comes from defaultLocalBusiness in astro.config.mjs -->
  <LocalBusinessSchema />
  <AutoBreadcrumbSchema />
  <ArticleSchema
    title="Structured data for Astro sites"
    description="How JSON-LD is generated from typed, validated component props."
    datePublished="2026-09-10"
    authorName="Jane Doe"
    imageUrl="https://example.com/images/structured-data.jpg"
    readingTimeMinutes={4}
  />
  <FAQSchema
    questions={[
      { question: 'What is this?', answer: 'An Astro integration.' },
      { question: 'How does it work?', answer: 'It injects JSON-LD.' },
    ]}
  />
  <ProductSchema
    name="Super Gadget"
    description="The best gadget ever"
    imageUrl="https://example.com/images/gadget.jpg"
    price={29.99}
    priceCurrency="EUR"
    availability="InStock"
    brand="Gadget Co"
    sku="SG-001"
    ratingValue={4.5}
    reviewCount={128}
  />
  <RecipeSchema
    name="Classic Chocolate Chip Cookies"
    description="Crispy edges, chewy and soft in the center."
    imageUrl="https://example.com/images/cookies.jpg"
    authorName="Baker Bob"
    prepTime="PT15M"
    cookTime="PT10M"
    recipeYield="12 cookies"
    ingredients={['200g butter', '150g brown sugar', '2 eggs', '300g flour']}
    instructions={[
      { name: 'Preheat', text: 'Preheat oven to 190°C.' },
      { name: 'Bake', text: 'Scoop onto a sheet and bake for 10 minutes.' },
    ]}
  />
  <VideoSchema
    name="Introduction to Server Islands"
    description="A short tutorial on Server Islands and performance."
    thumbnailUrl="https://example.com/images/tutorial.jpg"
    uploadDate="2026-06-01"
    duration="PT8M45S"
    contentUrl="https://example.com/videos/tutorial.mp4"
  />
  <EventSchema
    name="Astro Live Webinar"
    description="Structured data in Astro, live with Q&A."
    startDate="2026-10-20T17:00:00+02:00"
    endDate="2026-10-20T18:30:00+02:00"
    attendanceMode="Online"
    onlineUrl="https://example.com/live"
    organizer={{ name: 'Example GmbH', url: 'https://example.com' }}
    price={0}
    priceCurrency="EUR"
  />
  <JobPostingSchema
    title="Remote Frontend Engineer"
    description="<p>Fully remote position open worldwide.</p>"
    hiringOrganizationName="ACME GmbH"
    datePosted="2026-09-01"
    validThrough="2026-12-31"
    jobLocationType="TELECOMMUTE"
    applicantLocationRequirements="DE"
    employmentType="FULL_TIME"
    baseSalary={{ value: 72000, currency: 'EUR', unit: 'YEAR' }}
  />
</head>
<body>
  <h1>Structured Data playground</h1>
  <p>
    Every schema component is on this page. Open the Astro dev toolbar and its Structured Data app
    to see the preview and warnings, or read the generated JSON-LD below.
  </p>
  <pre id="json-ld">Loading …</pre>

  <SchemaGraph />

  <script is:inline>
    const blocks = [...document.querySelectorAll('script[type="application/ld+json"]')]
      .map((script) => JSON.parse(script.textContent));
    document.getElementById('json-ld').textContent = JSON.stringify(blocks, null, 2);
  </script>
</body>
</html>
