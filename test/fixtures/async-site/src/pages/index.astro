---
import { LocalBusinessSchema } from '../../../../../dist/components.js';
import Layout from '../layouts/Layout.astro';
import Delayed from '../components/Delayed.astro';
---
<Layout>
  <!-- Site-wide schema placed into the layout's named head slot; it renders first, but the
       page's own (delayed) schema must still win. -->
  <LocalBusinessSchema slot="head" name="Fixture Shop" />
  <main>
    <Delayed />
  </main>
</Layout>
